# --- UYGULAMA ---
PORT=3000
NODE_ENV=production
TRUST_PROXY=1

# --- VERİTABANI ---
# Tek satırda: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://bagis:bagis123@db:5432/bagis_db

# Docker compose için ayrıca:
POSTGRES_USER=bagis
POSTGRES_PASSWORD=degistir-guclu-sifre
POSTGRES_DB=bagis_db

# --- GÜVENLİK ---
SECRET_KEY=degistir-en-az-32-karakter-rastgele-string
SESSION_SECRET=degistir-baska-bir-rastgele-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=degistir-guclu-admin-sifresi

# --- ARAYÜZ / ENTEGRASYON ---
# WordPress domain'i — virgülle ayırarak birden fazla yazılabilir
CORS_ORIGIN=https://wordpress-siteniz.com

# Telefon normalizasyonu için varsayılan ülke kodu
DEFAULT_COUNTRY_CODE=90
